name: 虚拟定位 (WLOC)
desc: 拦截 Apple 网络定位响应并替换坐标。在线选点：https://wloc-1993.575613136.workers.dev 。脚本地址已配置好，导入即用。

http:
  mitm:
    - "gs-loc.apple.com"
    - "gs-loc-cn.apple.com"
  script:
    # 核心：拦截网络定位响应并改写坐标
    - match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc
      name: wloc
      type: response
      require-body: true
      binary-body-mode: true
      timeout: 30
      argument: latitude=22.544577&longitude=113.94114&horizontalAccuracy=25&debug=false&licenseKey=
    # 选点：拦截 /wloc-settings/save 写入持久化存储（在线选点页会请求这个地址）
    - match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save
      name: wloc-settings
      type: request
      timeout: 10

script-providers:
  wloc:
    url: https://raw.githubusercontent.com/Lululu-0715/wloc/main/dist/wloc.js
    interval: 86400
  wloc-settings:
    url: https://raw.githubusercontent.com/Lululu-0715/wloc/main/dist/wloc-settings.js
    interval: 86400
