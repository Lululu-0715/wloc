#!name=Apple WLOC 定位修改（小火箭专用）
#!desc=Apple 网络定位修改（Shadowrocket 优化版）| 选点页面: https://wloc-1993.575613136.workers.dev/ | 直接在地图上点选位置即可
#!author=Lululu-0715
#!homepage=https://github.com/Lululu-0715/wloc
#!category=Tools

[Script]
Apple WLOC = type=http-response, pattern="^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc", requires-body=1, binary-body-mode=1, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/Lululu-0715/wloc/main/dist/wloc.js
WLOC Settings = type=http-request, pattern="^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save", requires-body=0, max-size=0, timeout=10, script-path=https://raw.githubusercontent.com/Lululu-0715/wloc/main/dist/wloc-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
